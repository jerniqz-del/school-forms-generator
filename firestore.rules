/**
 * @file Firestore Security Rules
 * @description This ruleset implements a role-based access control system with owner-override.
 *
 * Core Philosophy:
 *  - Users can read public content (news, announcements, issuances, schools, tools).
 *  - Users can only manage their own profiles (`/users/{userId}`).
 *  - Documents contain `authorId` which must match the authenticated user to authorize document modification (create/update/delete).
 *  - A 'super_admin' role has privileged access to manage all data.
 *
 * Data Structure:
 *  - User profiles are stored in `/users/{userId}`.
 *  - Public content is stored in top-level collections: `/news`, `/announcements`, `/issuances`, `/schools`, `/tools`.
 *  - Super admin accounts are stored in `/superAdmins/{userId}`
 *
 * Key Security Decisions:
 *  - Listing of users is disabled for privacy.
 *  - Role is denormalized into the UserProfile document for simplified rule evaluation.
 *  - All write operations on public collections require a valid user and `authorId` that matches the authenticated user's UID.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Verifies user authentication.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Enforces user ownership based on UID.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

        /**
     * @description Checks if the authenticated user is a super admin.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Checks the user's custom claim for 'super_admin' role.
     */
    function isSuperAdmin() {
      return isSignedIn() && (request.auth.token.role == 'super_admin');
    }

    /**
     * @description Checks if the authenticated user is the author of the resource.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Enforces that the authenticated user must be the author of the resource.
     */
    function isAuthor(authorId) {
      return isSignedIn() && (request.auth.uid == authorId);
    }

    /**
     * @description Checks if the authenticated user is the author of the existing resource.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Enforces that the authenticated user must be the author of the existing resource.
     */
    function isExistingAuthor(authorId) {
        return isAuthor(authorId) && resource != null;
    }


    /**
     * @description Manages user profiles. Only the user can read/write their own profile.
     * @path /users/{userId}
     * @allow (get, create, update, delete) - User with matching UID can access their own profile.
     * @deny (get, create, update, delete) - Any other user attempting to access another user's profile.
     * @principle Enforces user-ownership for profile data.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Disable listing of all users for privacy.
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(userId);
    }

    /**
     * @description Manages news articles. Public read, owner-only writes.
     * @path /news/{newsId}
     * @allow (get, list) - Any user can read news articles.
     * @allow (create) - Only an authenticated user can create a news article, and the authorId must match their UID.
     * @allow (update, delete) - Only the author of the news article can update or delete it.
     * @deny (create) - If authorId does not match the authenticated user's UID.
     * @deny (update, delete) - If the user is not the author of the news article.
     * @principle Public read with owner-only writes.
     */
    match /news/{newsId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isExistingAuthor(resource.data.authorId);
      allow delete: if isExistingAuthor(resource.data.authorId);
    }

    /**
     * @description Manages announcements. Public read, owner-only writes.
     * @path /announcements/{announcementId}
     * @allow (get, list) - Any user can read announcements.
     * @allow (create) - Only an authenticated user can create an announcement, and the authorId must match their UID.
     * @allow (update, delete) - Only the author of the announcement can update or delete it.
     * @deny (create) - If authorId does not match the authenticated user's UID.
     * @deny (update, delete) - If the user is not the author of the announcement.
     * @principle Public read with owner-only writes.
     */
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isExistingAuthor(resource.data.authorId);
      allow delete: if isExistingAuthor(resource.data.authorId);
    }

    /**
     * @description Manages issuances. Public read, owner-only writes.
     * @path /issuances/{issuanceId}
     * @allow (get, list) - Any user can read issuances.
     * @allow (create) - Only an authenticated user can create an issuance, and the authorId must match their UID.
     * @allow (update, delete) - Only the author of the issuance can update or delete it.
     * @deny (create) - If authorId does not match the authenticated user's UID.
     * @deny (update, delete) - If the user is not the author of the issuance.
     * @principle Public read with owner-only writes.
     */
    match /issuances/{issuanceId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isExistingAuthor(resource.data.authorId);
      allow delete: if isExistingAuthor(resource.data.authorId);
    }

    /**
     * @description Manages schools. Public read, owner-only writes.
     * @path /schools/{schoolId}
     * @allow (get, list) - Any user can read school information.
     * @allow (create) - Only an authenticated user can create a school, and the authorId must match their UID.
     * @allow (update, delete) - Only the author of the school can update or delete it.
     * @deny (create) - If authorId does not match the authenticated user's UID.
     * @deny (update, delete) - If the user is not the author of the school.
     * @principle Public read with owner-only writes.
     */
    match /schools/{schoolId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isExistingAuthor(resource.data.authorId);
      allow delete: if isExistingAuthor(resource.data.authorId);
    }

   /**
     * @description Manages tools. Public read, owner-only writes.
     * @path /tools/{toolId}
     * @allow (get, list) - Any user can read tool information.
     * @allow (create) - Only an authenticated user can create a tool, and the authorId must match their UID.
     * @allow (update, delete) - Only the author of the tool can update or delete it.
     * @deny (create) - If authorId does not match the authenticated user's UID.
     * @deny (update, delete) - If the user is not the author of the tool.
     * @principle Public read with owner-only writes.
     */
    match /tools/{toolId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isExistingAuthor(resource.data.authorId);
      allow delete: if isExistingAuthor(resource.data.authorId);
    }

    /**
     * @description Manages super admin accounts.
     * @path /superAdmins/{userId}
     * @allow (get, list) - Only a super admin can read super admin accounts.
     * @allow (create, update, delete) - Only a super admin can create, update, or delete super admin accounts.
     * @deny (get, list, create, update, delete) - If the user is not a super admin.
     */
    match /superAdmins/{userId} {
      allow get, list: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    /**
     * Marketplace catalog. Published products are readable; writes go through Admin SDK.
     */
    match /products/{productId} {
      allow get, list: if resource.data.status == 'published';
      allow create, update, delete: if false;
    }

    /**
     * Marketplace purchases. Owners can read their own records; writes go through Admin SDK.
     */
    match /purchases/{purchaseId} {
      allow get, list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }
  }
}